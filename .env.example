# ==============================================================================
# CONFIGURAÇÃO GERAL DA APLICAÇÃO & DOMÍNIO
# ==============================================================================
# Nome público da plataforma (exibido na interface, títulos, notificações)
NEXT_PUBLIC_APP_NAME="MozBet"

# URL base do frontend (sem barra final). Ex: https://seudominio.com ou http://localhost:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Domínio principal da aplicação (usado para validações de subdomínio e CORS). Ex: seudominio.com ou localhost
NEXT_PUBLIC_APP_DOMAIN="localhost"

# Domínio para cookies de autenticação em produção. 
# Deixe em branco se rodar em localhost ou sem subdomínios compartilhados.
# Em produção na VPS com domínio próprio, defina ex: .seudominio.com ou seudominio.com
COOKIE_DOMAIN=""

# E-mail de suporte exibido no rodapé e telas de ajuda
NEXT_PUBLIC_SUPPORT_EMAIL="suporte@seudominio.com"

# ==============================================================================
# BANCO DE DADOS (SUPABASE)
# ==============================================================================
# URL do seu projeto Supabase (obtenha em Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://seu-projeto.supabase.co"

# Chave anônima pública do Supabase (Project Settings -> API -> anon key)
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-chave-anon-publica-aqui"

# Chave Service Role (Project Settings -> API -> service_role key)
# ATENÇÃO: NUNCA expor ao cliente/frontend. Usada apenas em rotas de backend seguro.
SUPABASE_SERVICE_ROLE_KEY="sua-chave-service-role-aqui"

# ==============================================================================
# SEGURANÇA & SESSÃO (JWT)
# ==============================================================================
# Segredo para assinatura de tokens de sessão (JWT). Gere uma string longa e aleatória.
JWT_SECRET="gere-uma-chave-secreta-forte-e-aleatoria-aqui"

# Segredo de segurança para sincronização de histórico de jogos via webhook/API interna
GAME_API_SECRET="segredo-para-comunicacao-com-engine-de-jogos"

# ==============================================================================
# REALTIME & SERVIDOR WEBSOCKET (VPS / NODE.JS)
# ==============================================================================
# URL do servidor WebSocket (Socket.io) para o frontend se conectar
# Em desenvolvimento: http://localhost:3001
# Em produção: https://socket.seudominio.com ou https://api.seudominio.com
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"

# URL interna da VPS ou do servidor Socket para requisições do backend Next.js (ex: contagem de presença)
VPS_SOCKET_URL="http://localhost:3001"

# ==============================================================================
# GATEWAY DE PAGAMENTOS: E2PAYMENTS (M-PESA / E-MOLA)
# ==============================================================================
# URL base da API E2Payments
E2PAY_BASE_URL="https://mpesaemolatech.com"

# Credenciais OAuth2 do E2Payments
E2PAY_CLIENT_ID="seu-client-id-aqui"
E2PAY_CLIENT_SECRET="seu-client-secret-aqui"

# IDs das carteiras no E2Payments
E2PAY_WALLET_MPESA="id-da-carteira-mpesa"
E2PAY_WALLET_EMOLA="id-da-carteira-emola"

# ==============================================================================
# GATEWAY DE PAGAMENTOS: DEBITOPAY (M-PESA / E-MOLA / MKESH) - OPCIONAL
# ==============================================================================
# URL base da função/API do DebitoPay
DEBITOPAY_BASE_URL="https://sua-url-debitopay.supabase.co/functions/v1"
DEBITOPAY_API_KEY="sk_live_sua_chave_aqui"
DEBITOPAY_MERCHANT_ID="seu-merchant-id-aqui"
DEBITOPAY_MPESA_WALLET="codigo-carteira-mpesa"
DEBITOPAY_EMOLA_WALLET="codigo-carteira-emola"
DEBITOPAY_MKESH_WALLET="codigo-carteira-mkesh"
DEBITOPAY_WEBHOOK_SECRET="whsec_seu_segredo_de_webhook_aqui"

# ==============================================================================
# SERVIÇO DE SMS (MOZSMS) - ENVIO DE OTP
# ==============================================================================
MOZSMS_API_URL="https://api.mozesms.com/v4"
MOZSMS_API_KEY="sua-chave-api-mozsms"
MOZSMS_SECRET="seu-secret-mozsms"
MOZSMS_SENDER_ID="MOZOTP"

# ==============================================================================
# SERVIÇO DE E-MAIL (RESEND)
# ==============================================================================
# Chave de API do Resend (obtenha em https://resend.com)
RESEND_API_KEY="re_sua_chave_resend_aqui"

# Segredo de assinatura do webhook do Resend para validação de eventos
RESEND_WEBHOOK_SECRET="whsec_seu_webhook_secret_resend"

# E-mail remetente autenticado no Resend (ex: "Nome <suporte@seudominio.com>")
EMAIL_FROM="MozBet Suporte <suporte@seudominio.com>"

# ==============================================================================
# NOTIFICAÇÕES TELEGRAM (ALERTAS DE TRANSAÇÕES E SISTEMA)
# ==============================================================================
TELEGRAM_BOT_TOKEN="token-do-bot-telegram"
TELEGRAM_CHAT_ID="chat-id-para-receber-alertas"

# ==============================================================================
# SUPORTE COM IA (GOOGLE GEMINI)
# ==============================================================================
# Chave de API do Google AI Studio (obtenha em https://aistudio.google.com/)
GEMINI_API_KEY="sua-chave-gemini-aqui"

# ==============================================================================
# ASSETS & CDN (STORAGE EXTERNO / ORACLE / S3 / CLOUDINARY) - OPCIONAL
# ==============================================================================
# URL base para banners e imagens de jogos (se armazenados externamente)
NEXT_PUBLIC_ASSETS_BASE_URL=""
